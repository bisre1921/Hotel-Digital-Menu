DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hotel_menu_db?schema=public"
# Direct URL for Prisma schema pushes & migrations (required for pooled connections like Neon)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/hotel_menu_db?schema=public"
JWT_SECRET="replace-with-a-secure-random-secret-at-least-32-chars"
BETTER_AUTH_SECRET="replace-with-a-secure-random-secret-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Optional Cloud Storage configuration (Cloudinary, AWS S3, etc.)
# If omitted or left empty, the built-in resilient local media storage handler will be used.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Business subdomains (hostname only, no protocol; leave empty until configured)
# Local testing: NEXT_PUBLIC_ROOT_DOMAIN="localhost"
NEXT_PUBLIC_ROOT_DOMAIN=""

# Optional photo/PDF menu extraction. Server-only key. Use a model supporting
# image/PDF inputs and Responses API structured outputs. Both fields required.
OPENAI_API_KEY=""
OPENAI_MENU_MODEL=""
